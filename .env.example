# Copy these settings into .env.local and set your Supabase project's public values.
# Find them in the project's Connect dialog or Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use a modern sb_publishable_ key. No secret/service-role key is required by this app.
# Never place a secret key or account password in a NEXT_PUBLIC_ variable or Git.
